user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;

events {
    worker_connections  4096;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $upstream_addr [$time_local] "$request" '
                      'host="$host" -> ingress_host="$ingress_host" '
                      'status=$status rt=$request_time urt=$upstream_response_time';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    keepalive_timeout  65;

    # ---------------------------------------------------------------
    # upstream = kind 集群的 ingress-nginx NodePort 31000
    # 成员由容器内的 L7 健康检查（/healthz）动态生成，见 scripts/healthcheck.sh。
    # 静态文件不再手写，避免“节点已死但 upstream 里还有它”导致 3s 长尾。
    # ---------------------------------------------------------------
    upstream k8s_ingress_nodeport {
        least_conn;
        include /etc/nginx/upstream/nodeports.conf;
        keepalive 64;
        # 限制上游 keepalive 连接的寿命：否则 LB 会一直复用旧连接，
        # 节点侧的“摘流规则（只影响新连接）”根本不会生效，“等连接排空”也永远等不到。
        keepalive_time 10s;
        keepalive_requests 20;
    }

    # 通过 http://localhost:8080 直接访问时没有业务域名，这里把 Host 兜底成 demo.local；
    # 其它 Host 一律原样透传（这样才能验证 ingress 对未匹配 host 返 404）。
    map $host $ingress_host {
        hostnames;
        default             $host;
        ""                  demo.local;
        localhost           demo.local;
        localhost.localdomain demo.local;
        127.0.0.1           demo.local;
    }

    server {
        listen 80 default_server;
        server_name _;

        location / {
            proxy_pass http://k8s_ingress_nodeport;

            # 关键：必须把 Host 传给 ingress，否则 ingress 匹配不到 rule 会返回 404
            proxy_set_header Host              $ingress_host;

            proxy_http_version 1.1;
            proxy_set_header Connection        "";
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host  $ingress_host;

            proxy_connect_timeout __CONNECT_TIMEOUT__;
            proxy_send_timeout    5s;
            proxy_read_timeout    10s;      # 不要留默认 30s：半开连接会卡满 30s
            proxy_next_upstream   error timeout http_502 http_503 http_504;
            proxy_next_upstream_tries   2;  # 限制重试放大
            proxy_next_upstream_timeout 5s; # 必须 > 业务最长正常响应时间，否则重试被掉、反而制造 502
        }

        # 这个外部 nginx 自己的健康/统计入口
        location = /nginx-health {
            access_log off;
            return 200 "ok\n";
        }
        location = /nginx-stats {
            access_log off;
            stub_status;
        }
    }

    # 443 直接透传到 NodePort 31001（stream 层更干净，这里用 proxy_ssl 也能做，见 README）
}
